Subject: [PATCH] Preserve SYSVIPC ABI using slots 3/4/5 on LineageOS sm8450

Port of Droidspaces' 001.GKI-below-6.12-fix_sysvipc_kabi_3_4_5.patch
at cdadb9eb5d0f86aacffff60776333e6f6b73a30a.
Original patch author: nullptr-t-oss <127822226+nullptr-t-oss@users.noreply.github.com>

Only the surrounding context is changed: this LineageOS task_struct has
already consumed slots 1 and 2. Slots 3, 4 and 5 remain reserved.

diff --git a/include/linux/sched.h b/include/linux/sched.h
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -971,8 +971,8 @@ struct task_struct {
 	struct nameidata		*nameidata;
 
 #ifdef CONFIG_SYSVIPC
-	struct sysv_sem			sysvsem;
-	struct sysv_shm			sysvshm;
+	// struct sysv_sem			sysvsem;
+	// struct sysv_shm			sysvshm;
 #endif
 #ifdef CONFIG_DETECT_HUNG_TASK
 	unsigned long			last_switch_count;
@@ -1394,9 +1394,14 @@ struct task_struct {
 		unsigned	user_dumpable:1;
 		});
 
+#ifdef CONFIG_SYSVIPC
+	ANDROID_KABI_USE(3, struct sysv_sem sysvsem);
+	_ANDROID_KABI_REPLACE(ANDROID_KABI_RESERVE(4); ANDROID_KABI_RESERVE(5), struct sysv_shm sysvshm);
+#else
 	ANDROID_KABI_RESERVE(3);
 	ANDROID_KABI_RESERVE(4);
 	ANDROID_KABI_RESERVE(5);
+#endif
 	ANDROID_KABI_RESERVE(6);
 	ANDROID_KABI_RESERVE(7);
 	ANDROID_KABI_RESERVE(8);
